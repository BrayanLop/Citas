# ============================================================================
# Variables de entorno de Citas (plantilla, SIN valores reales).
#
#   cp .env.example .env      -> docker compose lo lee automáticamente.
#
# El .env real NUNCA se versiona (está en .gitignore). En Railway/servidor se
# definen estas mismas variables en el panel. Para `dotnet run` en local usa
# variables de entorno o `dotnet user-secrets` con las mismas claves (Jwt:Key...).
# ============================================================================

# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de la BD propia de Citas (Supabase/PostgreSQL). Obligatoria.
# (En docker compose se arma sola con las POSTGRES_* de abajo.)
ConnectionStrings__DefaultConnection=Host=TU_HOST;Port=5432;Database=TU_BD;Username=TU_USUARIO;Password=TU_PASSWORD

# Solo docker compose (contenedor local de PostgreSQL).
POSTGRES_DB=citas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

# --- JWT de clientes (lo emite Citas en /Auth/login y /Auth/select-empresa) ---
# El issuer NO puede ser igual al de Natural (Natural.Api). Key: mínimo 32 caracteres.
Jwt__Issuer=CitasApi
Jwt__Audience=CitasApiClients
Jwt__Key=PON_AQUI_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# --- JWT de Natural (personal de la empresa) ---------------------------------
# Debe ser EXACTAMENTE la misma clave con la que Natural firma sus tokens. Obligatoria.
NaturalJwt__Key=PON_AQUI_LA_MISMA_CLAVE_JWT_DE_NATURAL
# Opcionales (valores por defecto: Natural.Api / Natural.Client).
NaturalJwt__Issuer=Natural.Api
NaturalJwt__Audience=Natural.Client

# --- API de Natural (sincronización de servicios y personal) ------------------
# URL base de la API de Natural. Obligatoria. Citas llama a Servicio/Obtener y
# Persona/Obtener con el mismo token de Natural de la petición (no hay clave propia).
NaturalApi__BaseUrl=https://naturalback.vip/v2/api
# Opcionales: timeout de cada llamada (segundos, por defecto 15) y duración en minutos
# que reciben los servicios nuevos al sincronizar (por defecto 30).
NaturalApi__TimeoutSegundos=15
NaturalApi__TiempoEstimadoPorDefecto=30

# --- Agenda (opcionales) --------------------------------------------------------
# Zona horaria del negocio (IANA; si el sistema no la tiene se usa UTC-5 fijo), cada
# cuántos minutos se ofrecen horas de inicio y anticipación mínima para agendar.
Agenda__ZonaHoraria=America/Bogota
Agenda__IntervaloMinutos=15
Agenda__AnticipacionMinimaMinutos=0

# --- CORS ----------------------------------------------------------------------
# Orígenes permitidos (uno por índice). Vacío = cualquier origen, sin credenciales.
Cors__AllowedOrigins__0=

# --- ASP.NET Core --------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production   (docker compose usa Development por defecto)
# true = aplica las migraciones de EF al arrancar (útil con una BD vacía).
# RunMigrationsOnStartup=true          (docker compose la activa por defecto)
