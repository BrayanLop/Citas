<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5c7a1054-192e-4014-a1ad-e21b4b8aabf0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <!-- EF Core se mantiene porque algunos controladores aún consultan el DbContext
         directamente (estilo previo a DDD). El proveedor (Npgsql) y las Tools viven
         ahora en Citas.Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Citas.Application\Citas.Application.csproj" />
    <ProjectReference Include="..\Citas.Infrastructure\Citas.Infrastructure.csproj" />
  </ItemGroup>

</Project>
