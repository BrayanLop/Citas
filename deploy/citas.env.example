# Variables de entorno del contenedor de Citas en el servidor (archivo ~/citas.env).
# Este archivo es SOLO una plantilla: los valores reales se escriben en el servidor y
# NUNCA se versionan. Una variable por línea, sin comillas ni espacios alrededor del "=".

# BD propia de Citas (PostgreSQL / Supabase). Formato clave=valor de Npgsql, NO la URL postgresql://
# Con Supabase usa el "Session pooler" (puerto 5432); el usuario es  postgres.<ref-del-proyecto>
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=postgres;Username=postgres.<ref>;Password=<contraseña>;SSL Mode=Require;Trust Server Certificate=true

# JWT de los CLIENTES externos (lo emite Citas). Clave nueva y aleatoria de 32+ caracteres:
#   openssl rand -base64 48
Jwt__Issuer=CitasApi
Jwt__Audience=CitasApiClients
Jwt__Key=<clave-nueva-aleatoria>

# JWT del PERSONAL: es el de Natural. La clave debe ser EXACTAMENTE la misma con la que Natural
# firma sus tokens (la misma que ya está en ~/brar.env como NaturalJwt__Key).
NaturalJwt__Key=<misma-clave-de-natural>

# API de Natural, para sincronizar servicios y personal.
NaturalApi__BaseUrl=https://naturalback.vip/v2/api

# Primera vez (y mientras haya una sola copia del contenedor): crea/actualiza el esquema al arrancar.
RunMigrationsOnStartup=true
ASPNETCORE_ENVIRONMENT=Production

# Opcionales (valores por defecto entre paréntesis):
# Agenda__ZonaHoraria=America/Bogota
# Agenda__IntervaloMinutos=15
# Agenda__AnticipacionMinimaMinutos=0
# Cors__AllowedOrigins__0=https://<origen-web>      (solo si hay una versión web; la app móvil no lo necesita)
